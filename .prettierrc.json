{
  "printWidth": 100,
  "tabWidth": 4,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": "*.html", "options": { "tabWidth": 4 } },
    { "files": ["*.json", "*.md", "*.yml", "*.yaml"], "options": { "tabWidth": 2 } }
  ]
}
