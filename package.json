{
  "name": "nail-it",
  "private": true,
  "type": "module",
  "description": "Construction site stock taking. Static site, no build step. This file only holds the test tooling.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:rules": "firebase emulators:exec --only database --project demo-nailit \"node --test --test-concurrency=1 tests/rules/*.test.js\"",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "axe-core": "^4.10.2",
    "eslint": "^9.39.5",
    "firebase": "^11.10.0",
    "firebase-tools": "^13.35.1",
    "globals": "^15.15.0",
    "playwright-core": "1.49.1",
    "prettier": "^3.10.1"
  }
}
